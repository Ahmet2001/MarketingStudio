# Local API runtime
API_PORT=8787
DATABASE_PATH=storage/productmarketer.sqlite
STORAGE_PATH=storage
CREDENTIAL_KEY_PATH=storage/credentials.key

# Production deployments should set a stable 32-byte key encoded as base64
# or 64 hexadecimal characters. If omitted locally, a private key file is
# created automatically at CREDENTIAL_KEY_PATH.
# CREDENTIAL_ENCRYPTION_KEY=

# The working default is "local". Future production adapters can use
# provider credentials without changing the REST API or persistence schema.
AI_PROVIDER=local
# OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
