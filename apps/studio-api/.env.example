CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
STORYFORGE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Use these only for local UI testing without API charges.
STORYFORGE_TASKS_EAGER=false
STORYFORGE_MOCK_GENERATION=false
STORYFORGE_MOCK_STEP_SECONDS=0.35
STORYFORGE_MOCK_CONNECTIONS=false
STORYFORGE_PROMPT_AI_ENABLED=true
STORYFORGE_PROMPT_MODEL=gemini-3.5-flash-lite
# Used by prompt ideas and as an optional Google Gemini image-provider fallback.
GEMINI_API_KEY=

STORYFORGE_PUBLIC_API_URL=http://localhost:8000
STORYFORGE_FRONTEND_URL=http://localhost:5173

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORYFORGE_TOKEN_ENCRYPTION_KEY=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional fallbacks. Keys saved in API & models override these values.
REPLICATE_API_TOKEN=
FAL_KEY=
TOGETHER_API_KEY=
